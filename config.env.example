# =============================================================
# 透明代理网关配置模板
# 复制为 config.env 并填写实际值后运行 install.sh
#   cp config.env.example config.env && vim config.env
# 敏感字段（订阅 token / Tailscale authkey）请勿提交到 git
# =============================================================

# ---- 订阅 (必填, 含 & 等特殊字符必须加引号) ----
# 机场订阅 ClashMeta 格式地址，含 token
SUB_URL="https://example.com/api/v1/client/download/?token=REPLACE_WITH_TOKEN&flag=clashmeta"

# ---- GitHub 代理 (可选, 留空则直连 GitHub) ----
GH_PROXY=

# ---- 分流数据 ----
# 中国大陆 IP 列表 (BGP 聚合, CIDR 格式)
CIRA_URL=https://cira.moedove.com/china_all_v4.txt

# ---- 节点选择 (按订阅中的节点名后缀匹配) ----
NODE_DEFAULT=香港-AKiX          # 海外默认出口
NODE_VOWIFI=英国-UZ             # VoWiFi 落地 (建议 SS/VMess, VLESS+REALITY 经前置链路不可用)
NODE_VOWIFI_FRONT=香港-AKiX     # VoWiFi 前置代理

# ---- 域名直连白名单 (逗号分隔, 走国内 DNS 直连) ----
DIRECT_DOMAINS=REPLACE_WITH_YOUR_DOMAIN

# ---- geosite 分类 (中国大陆域名) ----
GEOSITE_CN_CATEGORY=CN

# ---- 版本锁定 ----
MIHOMO_VERSION=1.19.30
MOSDNS_VERSION=5.3.4

# ---- Tailscale (可选, 留空跳过) ----
TAILSCALE_LOGIN_SERVER=https://example.tailnet.example
TAILSCALE_AUTHKEY=hskey-auth-REPLACE
TAILSCALE_ACCEPT_ROUTES=yes
LAN_SUBNET=192.168.10.0/24      # 广播的 LAN 子网 (LAN 侧访问 Tailnet 必需)
TAILNET_ROUTE=100.64.48.0/22    # 保留的内核直连路由 (LAN->Tailnet 实际走 mihomo DIRECT)